{
  "name": "neylo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sandbox:payments": "tsx ops/payment-sandbox/run.ts",
    "test:payments": "tsx --test tests/unit/payment-sandbox.test.ts",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx tests/database/run.ts",
    "check": "npm run typecheck && npm test",
    "db:types": "supabase gen types typescript --local > src/lib/database.generated.ts",
    "db:push": "supabase db push",
    "dev:vinext": "vinext dev --port 3101",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "tsx ops/deploy-production.ts",
    "build:production": "tsx ops/build-production.ts",
    "admin:bootstrap": "tsx ops/bootstrap-owner.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "geist": "1.7.2",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "next": "16.3.5",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "vinext": "^1.0.0-beta.9",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "jsqr": "1.4.0",
    "pg": "8.23.0",
    "pngjs": "7.0.0",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
